# Nakili faili hii kuwa `.env` kisha jaza values zako.
#   Copy-Item .env.example .env

# --- App ----------------------------------------------------------------
ENV=development
DEBUG=true
APP_NAME="HomeSIEM API"

# Frontend (Vite) inaendesha port 5180, angalia frontend/vite.config.ts
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Postgres -----------------------------------------------------------
# docker-compose ina-publish 5433 kwenye host kwa sababu 5432 tayari
# imechukuliwa na Postgres nyingine kwenye mashine hii.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=homesiem
POSTGRES_PASSWORD=homesiem
POSTGRES_DB=homesiem

# --- Firebase -----------------------------------------------------------
# Pakua service account JSON kutoka:
#   Firebase Console > Project Settings > Service accounts > Generate new private key
# Kisha weka path yake hapa (USIIWEKE ndani ya git).
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=homesiem-fb222

# --- AI (Groq) ----------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Threat intel (AlienVault OTX) --------------------------------------
# Key inapatikana: otx.alienvault.com > Settings > OTX API Key (bure).
OTX_API_KEY=

# --- GeoIP (MaxMind GeoLite2) -------------------------------------------
# Jisajili bure: maxmind.com > My Account > Manage License Keys.
# Hizi ni za KUPAKUA .mmdb pekee. Lookup inafanyika offline kwenye faili
# hizo, hakuna network call kwa kila IP, hakuna rate limit.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIP_DB_DIR=./data/geoip

# --- Email (Brevo) ------------------------------------------------------
# Sender LAZIMA iwe imethibitishwa kwenye Brevo (Senders & IP > Senders),
# vinginevyo Brevo inakataa kila ujumbe kwa 400.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=maestrobusiness@aol.com
BREVO_SENDER_NAME=HomeSIEM
APP_PUBLIC_URL=http://localhost:5180

# --- Payments (ClickPesa) -----------------------------------------------
# ClickPesa Dashboard > Settings > Developers > Applications (Client ID + API Key).
# Zikiwepo zote mbili, ClickPesa inatumika badala ya malipo ya "manual".
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_BASE_URL=https://api.clickpesa.com
# Siri unayoiweka mwenyewe; inaingia mwishoni mwa webhook URL (ulinzi wa ziada).
CLICKPESA_WEBHOOK_SECRET=

# --- Password reset OTP -------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Dev bypass ---------------------------------------------------------
# ONYO: hii inaruhusu token bandia "dev:email@example.com" bila Firebase.
# Ni kwa development TU. Ikiwa ENV=production hii inapuuzwa kabisa.
AUTH_DEV_BYPASS=true
